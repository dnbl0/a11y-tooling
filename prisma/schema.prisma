// Shared data model for both scanning surfaces (live-site + design-time).
// A single results model is what makes the platform coherent: a designer's
// Figma scan and an engineer's CI scan land in the same Issue table as a
// live-site crawl, so every stakeholder sees one source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // swap to "postgresql" for production; sqlite keeps local setup zero-config
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  sites     Site[]
}

model Site {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  scans     Scan[]

  @@index([projectId])
}

enum ScanSource {
  LIVE_SITE   // Playwright crawl of rendered pages
  FIGMA       // design-time plugin
  COMPONENT   // engineer CI checker (Storybook / component routes)
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model Scan {
  id         String     @id @default(cuid())
  siteId     String
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source     ScanSource
  status     ScanStatus @default(QUEUED)
  score      Int? // 0-100, computed on completion
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  pages      Page[]

  @@index([siteId])
}

model Page {
  id             String   @id @default(cuid())
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url            String // for FIGMA/COMPONENT this is a frame name or story id
  title          String?
  score          Int? // 0-100 per page
  screenshotPath String? // relative path under /public/screenshots
  issues         Issue[]

  @@index([scanId])
}

enum Severity {
  CRITICAL
  SERIOUS
  MODERATE
  MINOR
}

model Issue {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ruleId      String // axe rule id, e.g. "color-contrast"
  wcagRef     String // e.g. "1.4.3"
  wcagLevel   String // "A" | "AA" | "AAA"
  severity    Severity
  needsReview Boolean  @default(false) // true = automation can't decide; human must verify
  help        String // plain-language explanation
  helpUrl     String?
  target      String // CSS selector / node path
  html        String // offending markup snippet
  // bounding box for the inspector overlay (live-site only)
  boxX        Int?
  boxY        Int?
  boxW        Int?
  boxH        Int?

  @@index([pageId])
  @@index([ruleId])
}
